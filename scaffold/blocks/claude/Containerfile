# From the signed Anthropic dnf repository.
RUN printf '%s\n' \
        '[claude-code]' \
        'name=Claude Code' \
        'baseurl=https://downloads.claude.ai/claude-code/rpm/{{.channel}}' \
        'enabled=1' \
        'gpgcheck=1' \
        'gpgkey=https://downloads.claude.ai/keys/claude-code.asc' \
        > /etc/yum.repos.d/claude-code.repo && \
    rpm --import https://downloads.claude.ai/keys/claude-code.asc && \
    dnf -y install claude-code && \
    dnf clean all && rm -rf /var/cache/dnf && \
    claude --version
