FROM fedora:{{.version}}

RUN dnf -y --setopt=install_weak_deps=False upgrade --refresh && \
    dnf -y --setopt=install_weak_deps=False install \
        git git-lfs \
        curl wget ca-certificates openssl \
        tar xz zip unzip bzip2 \
        which findutils procps-ng file diffutils \
        bash-completion vim-minimal ripgrep && \
    dnf clean all && rm -rf /var/cache/dnf
